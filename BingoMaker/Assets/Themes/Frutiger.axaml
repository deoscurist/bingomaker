<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:BingoMaker.Converters">
    <Design.PreviewWith>
        <Border Background="LightSeaGreen" Padding="64">
            <Border
                Classes="ListCard"
                Width="450">
                <StackPanel Spacing="8">
                    <TextBlock
                        Classes="Title"
                        Text="Title" />
                    <Border Classes="CardContent">
                        <StackPanel Spacing="8">
                            <TextBlock>
                                <Run>Param:</Run>
                                <Run Text="Some Value" />
                            </TextBlock>
                            <TextBlock>
                                <Run>Some:</Run>
                                <Run Text="Some Value" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <StackPanel Classes="CardActions">
                        <Button
                            CornerRadius="8"
                            Padding="8"
                            Background="{DynamicResource BrandOrange}">
                            <PathIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="16"
                                Height="16"
                                Foreground="#FF333333"
                                Data="{StaticResource Stats}">
                                <PathIcon.Effect>
                                    <DropShadowEffect
                                        Color="White"
                                        OffsetX="1"
                                        OffsetY="1"
                                        BlurRadius="1"
                                        Opacity="1" />
                                </PathIcon.Effect>
                            </PathIcon>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <BoxShadows x:Key="FrutigerContentShadow">0 4 8 0 #66000000</BoxShadows>
        <LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#80FFFFFF" Offset="0" />
            <GradientStop Color="#45FFFFFF" Offset="0.35" />
            <GradientStop Color="#18DDE3E8" Offset="0.65" />
            <GradientStop Color="#38F0F3F5" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BrightGlassHighlightBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#B8FFFFFF" Offset="0" />
            <GradientStop Color="#90FFFFFF" Offset="0.35" />
            <GradientStop Color="#58DDE3E8" Offset="0.55" />
            <GradientStop Color="#80F0F3F5" Offset="1" />
        </LinearGradientBrush>
        
        <Color x:Key="NavigationBarColor">#AAB4B9</Color>
        <Color x:Key="NavigationBarTextColor">#253746</Color>
        <BoxShadows x:Key="FrutigerNavigationBarShadow">inset 0 1 0 0 #80FFFFFF, inset 0 -1 0 0 #5036434B, 0 3 6 0 #50000000</BoxShadows>
    </Styles.Resources>
    
    <Style Selector="Grid.AppBackground">
        <Setter Property="Background" Value="#AAB4B9" />
    </Style>

    <Style Selector="NavigationPage">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#33000000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style Selector="NavigationPage /template/ Grid#PART_ContentHost">
        <Setter Property="Margin" Value="16,0,16,16" />
    </Style>

    <Style Selector="NavigationPage /template/ Border#PART_NavigationBar">
        <Setter Property="MaxWidth" Value="768" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ReflectionBinding TemplatedParent.CurrentPage, RelativeSource={RelativeSource Self}, Converter={x:Static converters:NavigationBarConverters.TopBackground}}" />
        <Setter Property="BorderBrush" Value="{ReflectionBinding TemplatedParent.CurrentPage, RelativeSource={RelativeSource Self}, Converter={x:Static converters:NavigationBarConverters.TopBorder}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource FrutigerNavigationBarShadow}" />
    </Style>

    <Style Selector="NavigationPage /template/ ContentPresenter#PART_Header">
        <Setter Property="FontWeight" Value="600" />
        <Setter Property="Padding" Value="16 0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{ReflectionBinding TemplatedParent.CurrentPage, RelativeSource={RelativeSource Self}, Converter={x:Static converters:NavigationBarConverters.TopForeground}}" />
    </Style>

    <Style Selector="NavigationPage /template/ ContentPresenter#PART_TopCommandBar">
        <Setter Property="Foreground" Value="{ReflectionBinding TemplatedParent.CurrentPage, RelativeSource={RelativeSource Self}, Converter={x:Static converters:NavigationBarConverters.TopForeground}}" />
        <Setter Property="Padding" Value="16 0" />
    </Style>

    <Style Selector="NavigationPage /template/ Border#BottomCommandBarSurface">
        <Setter Property="MaxWidth" Value="768" />
        <Setter Property="Margin" Value="16,0,16,16" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ReflectionBinding TemplatedParent.CurrentPage, RelativeSource={RelativeSource Self}, Converter={x:Static converters:NavigationBarConverters.BottomBackground}}" />
        <Setter Property="BorderBrush" Value="{ReflectionBinding TemplatedParent.CurrentPage, RelativeSource={RelativeSource Self}, Converter={x:Static converters:NavigationBarConverters.BottomBorder}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource FrutigerNavigationBarShadow}" />
    </Style>

    <Style Selector="NavigationPage /template/ ContentPresenter#PART_BottomCommandBar">
        <Setter Property="Foreground" Value="{ReflectionBinding TemplatedParent.CurrentPage, RelativeSource={RelativeSource Self}, Converter={x:Static converters:NavigationBarConverters.BottomForeground}}" />
    </Style>

    <Style Selector="NavigationPage /template/ Border#PART_NavigationBar Button">
        <Setter Property="Foreground"
                Value="{Binding $parent[NavigationPage].CurrentPage, Converter={x:Static converters:NavigationBarConverters.TopForeground}}" />
    </Style>

    <Style Selector="NavigationPage /template/ Border#BottomCommandBarSurface Button">
        <Setter Property="Foreground"
                Value="{Binding $parent[NavigationPage].CurrentPage, Converter={x:Static converters:NavigationBarConverters.BottomForeground}}" />
    </Style>

    <Style Selector="ContentPage:not(.flat)">
        <Setter Property="BorderBrush" Value="#33000000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource BrightGlassHighlightBrush}" />
    </Style>

    <Style Selector="ContentPage /template/ Border#PageSurface">
        <Setter Property="BoxShadow" Value="{DynamicResource FrutigerContentShadow}" />
    </Style>

    <Style Selector="ContentPage.flat /template/ Border#PageSurface">
        <Setter Property="BoxShadow" Value="none" />
    </Style>

    <Style Selector="Label">
        <Setter Property="FontWeight" Value="600" />
    </Style>

    <Style Selector="Button">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="#7F8C8D" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
        <Setter Property="Effect">
            <DropShadowEffect
                OffsetX="0"
                OffsetY="2"
                BlurRadius="4"
                Color="Black"
                Opacity="0.4" />
        </Setter>

        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_ButtonRootBorder"
                        Background="Transparent"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="False">
                    <Grid>
                        <Border x:Name="BackgroundBorder"
                                BorderBrush="#66ffffff"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{TemplateBinding Background}"
                                ClipToBounds="True">
                            <Panel>
                                <Grid x:Name="GlossLayer" RowDefinitions="*,*" IsHitTestVisible="False">
                                    <!-- Верхний блик: половина внутренней высоты кнопки. -->
                                    <Border Grid.Row="0"
                                            Margin="0,-1, 0,0"
                                            CornerRadius="{Binding Bounds.Height, RelativeSource={RelativeSource Self}, Converter={x:Static converters:HighlightConverters.TopCornerRadius}}"
                                            ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                <GradientStop Color="#aaFFFFFF" Offset="0.0" />
                                                <GradientStop Color="#33FFFFFF" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Нижний блик: половина внутренней высоты кнопки. -->
                                    <Border x:Name="BottomHighlight"
                                            Grid.Row="1"
                                            CornerRadius="{Binding Bounds.Height, RelativeSource={RelativeSource Self}, Converter={x:Static converters:HighlightConverters.BottomCornerRadius}}"
                                            ClipToBounds="True"
                                            IsHitTestVisible="False">
                                        <Border.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                            </Transitions>
                                        </Border.Transitions>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                                                <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                                                <GradientStop Color="#00FFFFFF" Offset="0.7" />
                                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <ContentPresenter x:Name="PART_ContentPresenter"
                                                  Background="Transparent"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}" />
                            </Panel>
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button TextBlock, Button PathIcon, NavigationPage /template/ ContentPresenter#PART_Header">
        <Setter Property="Effect">
            <DropShadowEffect Color="Black"
                              OffsetX="0"
                              OffsetY="0"
                              BlurRadius="2"
                              Opacity="0.6" />
        </Setter>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button:pointerover /template/ Border#PART_ButtonRootBorder">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button:pointerover /template/ Border#BackgroundBorder">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button /template/ Border#BottomHighlight">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <Style Selector="Button:pointerover /template/ Border#BottomHighlight">
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <Style Selector="Button:pressed /template/ Border#BottomHighlight">
        <Setter Property="Opacity" Value="0.2" />
    </Style>

    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground"
                Value="{ReflectionBinding TemplatedParent.Foreground, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button:disabled TextBlock, Button:disabled PathIcon">
        <Setter Property="Effect">
            <DropShadowEffect
                Color="White"
                OffsetX="1"
                OffsetY="1"
                BlurRadius="0"
                Opacity="0.4" />
        </Setter>
    </Style>
    <Style
        Selector="NavigationPage /template/ Border#PART_NavigationBar Button:pressed /template/ ContentPresenter#PART_ContentPresenter, NavigationPage /template/ Border#BottomCommandBarSurface Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground"
                Value="{ReflectionBinding TemplatedParent.Foreground, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style Selector="Button:disabled /template/ Border#BackgroundBorder">
        <Setter Property="Background" Value="#C4C8CB" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#777E84" />
    </Style>
    <Style Selector="Button:disabled /template/ Grid#GlossLayer">
        <Setter Property="Opacity" Value="0.2" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource NotificationInfo}" />

        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#253746" />
        <Setter Property="CaretBrush" Value="#238BC4" />
        <Setter Property="SelectionBrush" Value="#A9DCF5" />
        <Setter Property="SelectionForegroundBrush" Value="#172D3B" />
        <Setter Property="PlaceholderForeground" Value="#84939F" />

        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#E3EAF0" Offset="0" />
                <GradientStop Color="#F5F8FA" Offset="0.3" />
                <GradientStop Color="#FFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow"
                Value="inset 0 2 4 0 #300D2638, 0 1 0 0 #CCFFFFFF" />

        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow"
                                      Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style
        Selector="TextBox:not(:pointerover):not(:focus):not(:error):not(:disabled) /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#8799A8" />
    </Style>

    <Style Selector="TextBox:pointerover, TextBox:focus">
        <Setter Property="Foreground" Value="#253746" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background"
                Value="{ReflectionBinding TemplatedParent.Background, RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderBrush"
                Value="{ReflectionBinding TemplatedParent.BorderBrush, RelativeSource={RelativeSource Self}, Converter={x:Static converters:TextBoxBorderConverters.Hover}}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background"
                Value="{ReflectionBinding TemplatedParent.Background, RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderThickness"
                Value="{ReflectionBinding TemplatedParent.BorderThickness, RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderBrush"
                Value="{ReflectionBinding TemplatedParent.BorderBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="BoxShadow"
                Value="inset 0 2 4 0 #240D2638, 0 0 5 1 #603AB9F0" />
    </Style>

    <Style Selector="TextBox:error /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource NotificationError}" />
        <Setter Property="BoxShadow"
                Value="inset 0 2 4 0 #240D2638, 0 0 4 1 #40EF3545" />
    </Style>

    <Style Selector="TextBox:disabled">
        <Setter Property="Foreground" Value="#899299" />
        <Setter Property="PlaceholderForeground" Value="#9BA3AA" />
    </Style>

    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#E3E7EA" />
        <Setter Property="BorderBrush" Value="#B5BEC5" />
        <Setter Property="BoxShadow"
                Value="inset 0 1 3 0 #160D2638, 0 1 0 0 #80FFFFFF" />
    </Style>
    
    <Style Selector="Border.ListCard">
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="BorderBrush" Value="#88FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#EEE" Offset="0"/>
                <GradientStop Color="#BBB" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BoxShadow" Value="0 2 4 #cc000000"/>
    </Style>
    
    <Style Selector="Border.ListCard TextBlock.Title">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="#333"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="White"
                              OffsetX="1"
                              OffsetY="1"
                              BlurRadius="0"
                              Opacity="1" />
        </Setter>
    </Style>
    
    <Style Selector="Border.ListCard Border.CardContent">
    </Style>  
    
    <Style Selector="Border.ListCard Border.CardContent Border.CardContentInner">
        <Setter Property="Padding" Value="8 16"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#33000000"/>
        <Setter Property="BoxShadow" Value="inset 0 0 4 #66000000"/>
        <Setter Property="Background" Value="White"/>
    </Style>    
    
    <Style Selector="Border.ListCard Border.CardActions">
    </Style>

    <Style Selector="Border.BingoTable">
        <Setter Property="Background" Value="#EEEEEE"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BoxShadow" Value="inset 0 0 4 #66000000"/>
        <Setter Property="BorderBrush" Value="#33000000"/> 
        <Setter Property="BorderThickness" Value="1"/> 
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="Border.BingoTable Border.BingoCell">
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BoxShadow" Value="0 0 8 #66000000"/>
        <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/> 
        <Setter Property="Background" Value="{StaticResource BrightGlassHighlightBrush}"/>
    </Style>

    <Style Selector="NavigationPage /template/ Button#PART_BackButton">
        <Setter Property="Background" Value="{ReflectionBinding TemplatedParent.CurrentPage, RelativeSource={RelativeSource Self}, Converter={x:Static converters:NavigationBarConverters.TopBaseBrush}}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="16 0" />
    </Style>
</Styles>