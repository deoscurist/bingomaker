<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BingoMaker.ViewModels"
             xmlns:design="using:BingoMaker.Design"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             x:Class="BingoMaker.Views.NotificationView"
             x:DataType="vm:NotificationViewModel"
             d:DataContext="{x:Static design:DesignData.Notification}"
             Loaded="OnLoaded"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">
    <UserControl.Styles>
        <Style Selector="Border.NotificationBox">
            <Setter Property="Background" Value="LightGray"/>
        </Style>
        <Style Selector="Border.NotificationBox.Info">
            <Setter Property="Background" Value="LightBlue"/>
        </Style>
        <Style Selector="Border.NotificationBox.Warning">
            <Setter Property="Background" Value="LightSalmon"/>
        </Style>
        <Style Selector="Border.NotificationBox.Success">
            <Setter Property="Background" Value="LightGreen"/>
        </Style>
        <Style Selector="Border.NotificationBox.Error">
            <Setter Property="Background" Value="LightCoral"/>
        </Style>
    </UserControl.Styles>
    
    <Border
        x:Name="NotificationBorder"
        Classes="NotificationBox"
        Classes.Info="{Binding IsInfo}"
        Classes.Warning="{Binding IsWarning}"
        Classes.Success="{Binding IsSuccess}"
        Classes.Error="{Binding IsError}"
        RenderTransform="translate(400px)"
        CornerRadius="8"
        BoxShadow="4 4 8 #33000000">
        <Border.Transitions>
            <Transitions>
                <TransformOperationsTransition
                    Property="RenderTransform"
                    Duration="0:0:0.3"
                    Easing="CubicEaseOut"/>
            </Transitions>
        </Border.Transitions>
        
        <Border
            CornerRadius="8"
            BorderBrush="#44000000"
            BorderThickness="1"
            Padding="8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8" Margin="8 0">
                    <TextBlock 
                        TextWrapping="Wrap" 
                        FontSize="16"
                        Text="{Binding Title}" />
                    <TextBlock 
                        TextWrapping="Wrap" 
                        FontSize="12"
                        Text="{Binding Message}" />
                </StackPanel>
                <Button 
                    Grid.Column="1"
                    Click="OnCloseClick"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="16"
                    Height="16"
                    FontSize="12"
                    Padding="4"
                    DockPanel.Dock="Top">
                    <TextBlock FontSize="8" VerticalAlignment="Center" HorizontalAlignment="Center" Text="X"/>
                </Button>
            </Grid>
        </Border>
    </Border>
</UserControl>