<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BingoMaker.ViewModels.Game"
             xmlns:views="using:BingoMaker.Views.Game"
             xmlns:design="using:BingoMaker.Design"
             xmlns:templates="using:BingoMaker.Views.Templates"
             NavigationPage.HasNavigationBar="True"
             NavigationPage.BarLayoutBehavior="Overlay"
             Header="Choose bingo:"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             d:DataContext="{x:Static design:DesignData.GameSetup}"
             x:DataType="vm:GameSetupViewModel"
             x:Class="BingoMaker.Views.Game.GameSetupView">
    <ContentPage.Resources>
        <StaticResource x:Key="FrutigerBarColor" ResourceKey="NotificationSuccess"/>
        <Color x:Key="FrutigerBarTextColor">White</Color>
    </ContentPage.Resources>
    
    <ScrollViewer>
        <StackPanel Margin="16">
            <ItemsControl ItemsSource="{Binding Bingos}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <templates:ListCard Title="{Binding Bingo.Title}">
                            <templates:ListCard.Content>
                                <Border Classes="CardContentInner">
                                    <StackPanel Spacing="8">
                                        <TextBlock>
                                            <Run>Last played:</Run>
                                            <Run Text="{Binding  LatestFinishedAt}"/>
                                        </TextBlock>
                                        <TextBlock>
                                            <Run>Total games:</Run>
                                            <Run Text="{Binding TotalCount}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </templates:ListCard.Content>
                            <templates:ListCard.Actions>
                                <StackPanel Spacing="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Button
                                        CornerRadius="8"
                                        Padding="8"
                                        Command="{Binding $parent[views:GameSetupView].((vm:GameSetupViewModel)DataContext).OpenStatsCommand}"
                                        CommandParameter="{Binding Bingo}"
                                        Background="{DynamicResource BrandOrange}">
                                        <PathIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="16"
                                            Height="16"
                                            Foreground="#FF333333"
                                            Data="{StaticResource Stats}">
                                            <PathIcon.Effect>
                                                <DropShadowEffect
                                                    Color="White"
                                                    OffsetX="1"
                                                    OffsetY="1"
                                                    BlurRadius="1"
                                                    Opacity="1" />
                                            </PathIcon.Effect>
                                        </PathIcon>
                                    </Button>
                                    <Button
                                        CornerRadius="8"
                                        Padding="8"
                                        Command="{Binding $parent[views:GameSetupView].((vm:GameSetupViewModel)DataContext).StartGameCommand}"
                                        CommandParameter="{Binding Bingo}"
                                        Background="{DynamicResource BrandGreen}">
                                        <PathIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="16"
                                            Height="16"
                                            Foreground="#FF333333"
                                            Data="{StaticResource Play}">
                                            <PathIcon.Effect>
                                                <DropShadowEffect
                                                    Color="White"
                                                    OffsetX="1"
                                                    OffsetY="1"
                                                    BlurRadius="1"
                                                    Opacity="1" />
                                            </PathIcon.Effect>
                                        </PathIcon>
                                    </Button>
                                </StackPanel>
                            </templates:ListCard.Actions>
                        </templates:ListCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</ContentPage>
