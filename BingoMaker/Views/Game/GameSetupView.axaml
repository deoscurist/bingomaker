<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BingoMaker.ViewModels.Game"
             NavigationPage.HasNavigationBar="True"
             NavigationPage.BarLayoutBehavior="Overlay"
             Header="Choose bingo:"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             x:DataType="vm:GameSetupViewModel"
             x:Class="BingoMaker.Views.Game.GameSetupView">
    
    <Design.DataContext>
        <vm:GameSetupViewModel/>
    </Design.DataContext>
    
    <ScrollViewer Padding="0 56 0 24">
        <StackPanel Margin="16">
            <ItemsControl ItemsSource="{Binding Bingos}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            CornerRadius="16"
                            Padding="24"
                            Background="LightGray"
                            >
                            <StackPanel>
                                <TextBlock Height="64" VerticalAlignment="Top" FontSize="24" HorizontalAlignment="Center" Text="{Binding Title}"/>
                                <StackPanel Spacing="8">
                                    <TextBlock>
                                        <Run>Last played:</Run>
                                        <Run Text="{Binding CreatedAt}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run>Total games:</Run>
                                        <Run>1337</Run>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</ContentPage>
