<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BingoMaker.ViewModels.Editor"
             xmlns:design="using:BingoMaker.Design"
             xmlns:views="using:BingoMaker.Views.Editor"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             NavigationPage.HasNavigationBar="True"
             NavigationPage.BarLayoutBehavior="Overlay"
             Header="Your bingos:"
             x:Name="BingoList"
             d:DataContext="{x:Static design:DesignData.BingoList}"
             x:Class="BingoMaker.Views.Editor.BingoListView"
             x:DataType="vm:BingoListViewModel">
    <ContentPage.Resources>
        <StaticResource x:Key="NavigationBarColor" ResourceKey="BrandOrange"/>
        <Color x:Key="NavigationBarTextColor">White</Color>
    </ContentPage.Resources>
    
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="16">
            <Button
                FontWeight="600"
                Command="{Binding BingoFormCommand}"
                Background="{DynamicResource NotificationSuccess}"
                HorizontalAlignment="Stretch">
                <Button.Content>
                    <TextBlock HorizontalAlignment="Center">
                        Create Bingo
                    </TextBlock>
                </Button.Content>
            </Button>
            <ItemsControl 
                IsVisible="{Binding !!Bingos.Count}" 
                ItemsSource="{Binding Bingos}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BingoCardViewModel">
                        <views:BingoCardView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border
                MinWidth="256"
                HorizontalAlignment="Center"
                Background="LightGray"
                BorderBrush="#66000000"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                IsVisible="{Binding !Bingos.Count}">
                <StackPanel
                    Spacing="8"
                    Orientation="Vertical">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="No items"
                        IsVisible="{Binding !Bingos.Count}"/>
                    <Button
                        HorizontalAlignment="Center"
                        Command="{Binding LoadBingosCommand}" 
                        Content="Reload"
                        IsVisible="{Binding !IsLoaded}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentPage>
