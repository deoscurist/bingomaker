<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BingoMaker.ViewModels.Editor"
             xmlns:design="using:BingoMaker.Design"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             NavigationPage.HasNavigationBar="True"
             NavigationPage.BarLayoutBehavior="Overlay"
             Header="Your bingos:"
             x:Name="BingoList"
             d:DataContext="{x:Static design:DesignData.BingoList}"
             x:Class="BingoMaker.Views.Editor.BingoListView"
             x:DataType="vm:BingoListViewModel">
    <ScrollViewer Padding="0 56 0 24">
        <StackPanel Margin="16" Spacing="16">
            <Button
                Command="{Binding BingoFormCommand}"
                Background="GreenYellow" 
                HorizontalAlignment="Stretch">
                <Button.Content>
                    <TextBlock HorizontalAlignment="Center">
                        Create Bingo
                    </TextBlock>
                </Button.Content>
            </Button>
            <ItemsControl 
                IsVisible="{Binding !!Bingos.Count}" 
                ItemsSource="{Binding Bingos}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Tapped="BingoForm_OnTapped"
                            CornerRadius="16"
                            Padding="24"
                            Background="LightGray"
                        >
                            <StackPanel>
                                <TextBlock Height="64" VerticalAlignment="Top" FontSize="24" HorizontalAlignment="Center" Text="{Binding Title}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock>
                                            <Run>Created At:</Run>
                                            <Run Text="{Binding CreatedAt}"/>
                                        </TextBlock>
                                        <TextBlock>
                                            <Run>Items:</Run>
                                            <Run Text="{Binding Items.Count}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                        <Button
                                            Command="{Binding #BingoList.((vm:BingoListViewModel)DataContext).DeleteCommand}"
                                            CommandParameter="{Binding}"
                                            Background="IndianRed"
                                            Content="Delete"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border
                MinWidth="256"
                HorizontalAlignment="Center"
                Background="LightGray"
                BorderBrush="#66000000"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                IsVisible="{Binding !Bingos.Count}">
                <StackPanel
                    Spacing="8"
                    Orientation="Vertical">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="No items"
                        IsVisible="{Binding !Bingos.Count}"/>
                    <Button
                        HorizontalAlignment="Center"
                        Command="{Binding LoadBingosCommand}" 
                        Content="Reload"
                        IsVisible="{Binding !IsLoaded}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentPage>
