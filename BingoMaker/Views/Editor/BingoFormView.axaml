<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BingoMaker.ViewModels.Editor"
             xmlns:design="using:BingoMaker.Design"
             xmlns:controls="using:BingoMaker.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             NavigationPage.HasNavigationBar="True"
             NavigationPage.BarLayoutBehavior="Overlay"
             Header="{Binding Header}"
             d:DataContext="{x:Static design:DesignData.BingoForm}"
             x:Class="BingoMaker.Views.Editor.BingoFormView"
             CornerRadius="8"
             x:Name="BingoFormPage"
             x:DataType="vm:BingoFormViewModel">
    <ContentPage.Resources>
        <StaticResource x:Key="NavigationBarColor" ResourceKey="BrandOrange"/>
        <Color x:Key="NavigationBarTextColor">White</Color>
    </ContentPage.Resources>
    
    <ContentPage.Styles>
        <Style Selector="Border.BingoCell:not(.removing)">
            <Style.Animations>
                <Animation Duration="0:0:0.2"
                           IterationCount="1">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.BingoCell.removing">
            <Setter Property="IsHitTestVisible" Value="False" />

            <Style.Animations>
                <Animation Duration="0:0:0.2"
                           IterationCount="1"
                           FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ContentPage.Styles>
    
    <NavigationPage.BottomCommandBar>
        <DockPanel 
            LastChildFill="False" 
            HorizontalAlignment="Stretch">
            <Button
                DockPanel.Dock="Left"
                IsVisible="{Binding #BingoFormPage.((vm:BingoFormViewModel)DataContext).IsExists}"
                Command="{Binding #BingoFormPage.((vm:BingoFormViewModel)DataContext).DeleteCommand}"
                Background="{DynamicResource NotificationError}">
                Delete
            </Button>
            <Button
                DockPanel.Dock="Right"
                Background="{DynamicResource NotificationInfo}"
                Command="{Binding #BingoFormPage.((vm:BingoFormViewModel)DataContext).SaveCommand}">
                Save
            </Button>
        </DockPanel>
    </NavigationPage.BottomCommandBar>
    
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Margin="16" Spacing="16">
            <StackPanel>
                <Label Content="Title:" />
                <TextBox Text="{Binding Title}" PlaceholderText="Title here" />
            </StackPanel>
            <StackPanel Spacing="16">
                <DockPanel HorizontalAlignment="Stretch">
                    <Label DockPanel.Dock="Left" VerticalAlignment="Center">
                        Items:
                    </Label>
                    <Button
                        CornerRadius="8"
                        Padding="8"
                        Command="{Binding AddItemCommand}"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                        <PathIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="16"
                            Height="16"
                            Data="{StaticResource Plus}" />
                    </Button>
                </DockPanel>
                <Border
                    Classes="BingoTable" 
                    MaxWidth="720">
                    <ItemsControl ClipToBounds="False" IsVisible="{Binding Items.Count}" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:BingoPanel Size="{Binding Size}" Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BingoItemViewModel">
                                <Border
                                    Classes.removing="{Binding IsRemoving}"
                                    Classes="BingoCell">
                                    <DockPanel Margin="8">
                                        <Button
                                            CornerRadius="8"
                                            Padding="8"
                                            Command="{Binding $parent[ItemsControl].((vm:BingoFormViewModel)DataContext).RemoveItemCommand}"
                                            CommandParameter="{Binding}"
                                            DockPanel.Dock="Top"
                                            HorizontalAlignment="Right">
                                            <PathIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="8"
                                                Height="8"
                                                Data="{StaticResource Minus}" />
                                        </Button>
                                        <StackPanel
                                            Spacing="4"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center">
                                            <TextBox PlaceholderText="Text here..." Text="{Binding Text}" />
                                            <!-- <TextBlock HorizontalAlignment="Center" Text="or"/> -->
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentPage>