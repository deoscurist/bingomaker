<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BingoMaker.App"
             xmlns:local="using:BingoMaker"
             Name="Bingo Maker"
             RequestedThemeVariant="Light">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Assets/Icons.axaml"/>
                <ResourceInclude Source="/Views/Templates/ListCard.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About" Click="AppAbout_OnClick" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://BingoMaker/Assets/Styles/Common.axaml" />
        <StyleInclude Source="avares://BingoMaker/Views/Templates/NavigationPage.axaml" />
        <StyleInclude Source="avares://BingoMaker/Views/Templates/ContentPage.axaml" />
        <StyleInclude Source="avares://BingoMaker/Assets/Themes/Default.axaml" />
        <!-- <StyleInclude Source="avares://BingoMaker/Assets/Themes/Frutiger.axaml" /> -->
    </Application.Styles>
</Application>